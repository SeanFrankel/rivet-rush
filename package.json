{
  "name": "rivet-rush",
  "version": "0.4.0",
  "private": true,
  "description": "A side-scrolling arena brawler with private online crew rooms.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/host.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "test:friends": "node tools/friends-drill.cjs",
    "test:network": "node tools/network-drill.cjs",
    "test:soak": "node tools/soak.cjs",
    "check:docs": "node tools/check-docs.cjs",
    "release:build": "node tools/release.cjs build"
  },
  "dependencies": {
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
